# .gitignore
#
# Two things this file must never do, because both would be silent losses:
#   - ignore something the build reads at package time. `scripts/verify-package-files.mjs`
#     fails the build when a `files` entry is missing, so an ignored input breaks
#     `pnpm run build` rather than a release.
#   - ignore a lockfile. pnpm-lock.yaml and pnpm-workspace.yaml are inputs to a
#     reproducible install and are deliberately NOT listed here.
#
# Everything below is either reproduced by a command, a local tool, or a secret.

# --- dependencies -------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/
.yarnrc.yml

# --- build output -------------------------------------------------------------
dist/
build/
out/
*.tsbuildinfo

# --- test and coverage output -------------------------------------------------
coverage/
.nyc_output/
blob-report/
playwright-report/
test-results/
.playwright/
.vitest/

# --- tooling caches and reports ----------------------------------------------
.npm-cache/
.pnpm-store/
.pnpm-cache/
.size-tmp/
.knip-cache/
.eslintcache
size-limit-report.json

# --- local AI/agent tooling ---------------------------------------------------
# Worktrees live outside the tracked tree; nothing here is part of the package.
.kilo/

# --- local-only scratch -------------------------------------------------------
*.tgz
*.bak
*.orig
*.rej
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pylibs/

# --- packaged tarballs and release scratch -----------------------------------
# `pnpm pack` / `npm pack` output. The publish pipeline builds its own tarball.
codewithrajat-rm-logvault-*.tgz

# --- examples -----------------------------------------------------------------
# The guides are Markdown only and are not workspace members, so nothing here
# should ever appear. These entries stop a stray local install from being staged.
examples/**/node_modules/
examples/**/dist/
examples/**/.next/
examples/**/.angular/
examples/**/.vite/
examples/**/.turbo/
examples/**/coverage/

# --- generated documentation media -------------------------------------------
# The GIF is committed (README.md references it over raw.githubusercontent.com);
# the frames and pipeline scripts that produced it are regenerable and large.
assets/gif-src/

# --- editors and OS -----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json

# --- environment and secrets --------------------------------------------------
# .env / .env.local are listed explicitly rather than as .env* so that a committed
# template such as .env.example stays visible when one is added.
.env
.env.local
.env.*.local

# --- changesets ---------------------------------------------------------------
.changeset/*.md.bak
